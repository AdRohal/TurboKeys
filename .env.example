# Settings > API. Both values are public: they ship to the browser, and row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://tqiqcjilhcaocebeeyac.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older projects call this key "anon". It works too, if the publishable key is not set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public address of the site, used for canonical links, the sitemap and social cards. Defaults to https://turbokeys.vercel.app
# NEXT_PUBLIC_SITE_URL=https://turbokeys.vercel.app
